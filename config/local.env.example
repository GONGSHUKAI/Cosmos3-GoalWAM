# Copy this file to config/local.env and replace the placeholder paths.
# config/local.env is ignored by Git and may contain cluster-local credentials.

export ROBOTWIN_DATA_ROOT="${ROBOTWIN_DATA_ROOT:-/path/to/data}"
export COSMOS_WEIGHTS_ROOT="${COSMOS_WEIGHTS_ROOT:-/path/to/weights}"
export ROBOTWIN_DIR="${ROBOTWIN_DIR:-/path/to/RoboTwin}"
export ROBOTWIN_CONDA_ENV="${ROBOTWIN_CONDA_ENV:-robotwin}"
export CONDA_SH="${CONDA_SH:-${HOME}/miniconda3/etc/profile.d/conda.sh}"

export HF_HOME="${HF_HOME:-${HOME}/.cache/huggingface}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-${HOME}/.cache/uv}"
export BASE_CHECKPOINT_PATH="${BASE_CHECKPOINT_PATH:-/path/to/Cosmos3-Nano-dcp}"
export WAN_VAE_PATH="${WAN_VAE_PATH:-/path/to/Wan2.2_VAE.pth}"

# Prefer `hf auth login` and `wandb login`. Uncomment only for non-interactive use.
# export HF_TOKEN=""
# export WANDB_API_KEY=""

# Optional output location. The framework default is outputs/train under the repo.
# export IMAGINAIRE_OUTPUT_ROOT="/path/to/training-output"
